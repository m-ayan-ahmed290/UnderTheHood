 <application android:name=".HoodApp" android:label="UnderTheHood" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:usesCleartextTraffic="true" android:networkSecurityConfig="@xml/network_security" android:supportsRtl="true" android:extractNativeLibs="false">
